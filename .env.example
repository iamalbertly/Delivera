# Place this file in the repository root (same folder as package.json). The server always loads
# that path first, then merges variables from the process working directory if present.
# Use UTF-8 without BOM; do not wrap values in quotes unless you intend quotes to be part of the value.
# JIRA_HOST must be the site base URL only (no /jira suffix for Cloud).
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Optional auth backend: SuperTokens (recommended for multi-user + RBAC scaling)
# Set SUPERTOKENS_ENABLED=true to turn on SuperTokens session validation.
# Hybrid mode keeps legacy login working while accepting SuperTokens sessions.
SUPERTOKENS_ENABLED=false
SUPERTOKENS_HYBRID_MODE=true
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=Delivera
# Match the port Delivera actually listens on (see .delivera-dev-port after dev:safe auto-pick).
SUPERTOKENS_API_DOMAIN=http://localhost:3000
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3000
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/auth

# Optional shared cache (recommended for multi-instance deployments)
CACHE_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379

# Optional AI provider for governed agentic workflows.
# If OPENROUTER_API_KEY is present and AI_PROVIDER is blank, the server auto-selects OpenRouter.
# Default model is chosen for low cost + capable structured output.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL_DEFAULT=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_GOVERNANCE=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_SIMPLE_COPY=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_FEEDBACK=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_VISION=google/gemini-2.5-flash-lite
