{
  "collectors": [
    {
      "id": "explore-page",
      "tier": 1,
      "cmd": "node .autohacker/collectors/explore-page.mjs",
      "outputs": [
        ".autohacker/runs/{runId}/exploration-report.json",
        ".autohacker/runs/{runId}/exploration-report.md"
      ]
    },
    {
      "id": "ux-metrics",
      "tier": 1,
      "cmd": "node .autohacker/collectors/synthesize-ux-metrics.mjs",
      "outputs": [".autohacker/runs/{runId}/metrics-snapshot.json"]
    },
    {
      "id": "hidden-value",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-hidden-value.mjs",
      "outputs": [".autohacker/runs/{runId}/hidden-value-report.json"]
    },
    {
      "id": "intra-card-void",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-intra-card-void.mjs",
      "outputs": [".autohacker/runs/{runId}/intra-card-void-report.json"]
    },
    {
      "id": "duplicate-text",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-duplicate-visible-text.mjs",
      "outputs": [".autohacker/runs/{runId}/duplicate-text-report.json"]
    },
    {
      "id": "main-column-void",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-main-column-void.mjs",
      "outputs": [".autohacker/runs/{runId}/main-column-void-report.json"]
    },
    {
      "id": "negative-void",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-negative-void.mjs",
      "outputs": [".autohacker/runs/{runId}/negative-void-report.json"]
    },
    {
      "id": "horizontal-void",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-horizontal-void.mjs",
      "outputs": [".autohacker/runs/{runId}/horizontal-void-report.json"]
    },
    {
      "id": "content-overlap",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-content-overlap.mjs",
      "outputs": [".autohacker/runs/{runId}/content-overlap-report.json"]
    },
    {
      "id": "fold-clipping",
      "tier": 1,
      "cmd": "node .autohacker/collectors/detect-fold-clipping.mjs",
      "outputs": [".autohacker/runs/{runId}/fold-clipping-report.json"]
    },
    {
      "id": "screenshot-density",
      "tier": 1,
      "cmd": "node .autohacker/collectors/analyze-screenshot-density.mjs",
      "outputs": [
        ".autohacker/runs/{runId}/screenshot-density-report.json",
        ".autohacker/runs/{runId}/screenshots/desktop-fold.png"
      ]
    },
    {
      "id": "state-matrix",
      "tier": 1,
      "cmd": "node .autohacker/collectors/synthesize-state-matrix.mjs",
      "outputs": [".autohacker/runs/{runId}/state-matrix-summary.json"]
    },
    {
      "id": "click-fast",
      "tier": 1,
      "cmd": "node scripts/audit-governance-clicks-fast.mjs",
      "outputs": ["test-results/governance-click-audit-fast.json"]
    },
    {
      "id": "layout-rects",
      "tier": 2,
      "cmd": "node scripts/audit-governance-layout-rects-headed.mjs",
      "env": { "HEADLESS": "1" },
      "outputs": [
        "test-results/governance-layout-rects-audit.json",
        "test-results/governance-layout-overlap-plan.md"
      ]
    },
    {
      "id": "duplicate-text-full-catalog",
      "tier": 2,
      "cmd": "node .autohacker/collectors/detect-duplicate-visible-text.mjs",
      "env": { "AUTOHACKER_CATALOG": "full", "AUTOHACKER_DUP_OUT": "duplicate-text-full-catalog-report.json" },
      "outputs": [".autohacker/runs/{runId}/duplicate-text-full-catalog-report.json"]
    },
    {
      "id": "click-full",
      "tier": 3,
      "cmd": "node scripts/audit-governance-full-clickmap.mjs",
      "outputs": ["test-results/governance-full-clickmap.json"]
    }
  ]
}
