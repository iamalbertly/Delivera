{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:css",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "lib/**",
        "routes/**",
        "public/**",
        "docs/**",
        "data/**",
        "package.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
